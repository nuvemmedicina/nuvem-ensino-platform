# ─── DATABASE ────────────────────────────────────────────────────────────────
# Neon PostgreSQL (https://neon.tech)
DATABASE_URL="postgresql://user:password@host/nuvem_ensino?sslmode=require"

# ─── AUTH.JS ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── STRIPE (pagamentos internacionais) ───────────────────────────────────────
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── MERCADO PAGO (PIX / boleto / parcelamento) ───────────────────────────────
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."
MP_WEBHOOK_SECRET="your-mp-webhook-secret"

# ─── ASAAS (PIX / boleto / cartão parcelado — usado por lib/asaas.ts) ────────
ASAAS_API_KEY="your-asaas-api-key"
ASAAS_SANDBOX="true"
ASAAS_WEBHOOK_TOKEN="your-asaas-webhook-access-token"

# ─── RESEND (emails transacionais) ────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="Nuvem Ensino <cursos@nuvemensino.com.br>"

# ─── VERCEL BLOB (upload de imagens) ─────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ─── MUX (hospedagem de vídeos) ───────────────────────────────────────────────
MUX_TOKEN_ID="your-mux-token-id"
MUX_TOKEN_SECRET="your-mux-token-secret"
MUX_WEBHOOK_SECRET="your-mux-webhook-secret"

# ─── ANTHROPIC (chat com IA) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── GOOGLE CALENDAR (aulas ao vivo) ─────────────────────────────────────────
GOOGLE_CALENDAR_ID="your-calendar-id"

# ─── CRON ────────────────────────────────────────────────────────────────────
# Protege o endpoint /api/cron/reminders contra acesso não autorizado
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET="your-cron-secret-here"

# ─── SENTRY (monitoramento de erros) ─────────────────────────────────────────
# DSN disponível em: sentry.io → Settings → Projects → Client Keys
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# Auth token para upload de source maps no CI/CD (NÃO commitar)
SENTRY_AUTH_TOKEN="sntrys_..."

# ─── GOOGLE TAG MANAGER / GA4 (medição) ──────────────────────────────────────
# ID do contêiner do Tag Manager (tagmanager.google.com), formato GTM-XXXXXXX.
# O código só carrega o GTM, o GA4 é configurado como tag dentro do próprio
# contêiner, apontando para o Measurement ID (G-XXXXXXXXXX) do GA4.
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# GA4 → Administrador → Fluxos de dados → (escolha o fluxo do site) → Measurement ID.
# Não é secreto (já aparece em toda página via GTM), mas fica separado do
# NEXT_PUBLIC_GTM_ID porque é usado só do lado do servidor (Etapa 3, evento
# de compra), não pelo navegador.
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# GA4 → Administrador → Fluxos de dados → (escolha o fluxo do site) →
# Measurement Protocol API secrets → Criar. Esse sim é secreto, nunca commitar
# nem expor no navegador (por isso sem o prefixo NEXT_PUBLIC_).
GA4_API_SECRET="your-ga4-measurement-protocol-secret"

# ─── META PIXEL / API DE CONVERSÕES (medição, Etapa 4) ───────────────────────
# O Pixel em si é carregado só pelo GTM (Custom HTML, configuração pendente
# em docs/medicao/03-etapa4-passos-manuais.md), não pelo navegador via este
# código. Essas duas variáveis são usadas só do lado do servidor, para o
# evento de compra (mesma lógica do GA4_MEASUREMENT_ID/GA4_API_SECRET acima).
# Meta Business → Gerenciador de eventos → Origens de dados → (o Pixel) →
# Configurações → ID do Pixel.
META_PIXEL_ID="123456789012345"
# Meta Business → Gerenciador de eventos → (o Pixel) → Configurações →
# API de Conversões → Gerar token de acesso. Secreto, nunca commitar nem
# expor no navegador.
META_CONVERSIONS_API_TOKEN="your-meta-conversions-api-token"

# ─── POSTHOG (analytics) ─────────────────────────────────────────────────────
# Disponível em: posthog.com → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── CRIPTOGRAFIA (chaves de API de IA) ─────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY="64_hex_chars_aqui"

# ─── IA — PROVEDORES EXTRAS ─────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
GOOGLE_AI_API_KEY="AIza..."
